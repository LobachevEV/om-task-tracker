{
  "track": "frontend",
  "surfaces": [
    {
      "id": "row_component_props_interfaces",
      "kind": "text",
      "command": "cd OneMoreTaskTracker.WebClient && (sed -n '/^export interface GanttFeatureRowProps/,/^}/p' src/pages/Gantt/components/GanttFeatureRow/GanttFeatureRow.tsx; echo '---'; sed -n '/^export interface GanttFeatureTrackBandProps/,/^}/p' src/pages/Gantt/components/GanttFeatureTrackBand/GanttFeatureTrackBand.tsx; echo '---'; sed -n '/^export interface GanttTrackStageRowProps/,/^}/p' src/pages/Gantt/components/GanttTrackStageRow/GanttTrackStageRow.tsx)",
      "tolerance": { "kind": "exact" }
    },
    {
      "id": "frozen_testids_rows",
      "kind": "text",
      "command": "cd OneMoreTaskTracker.WebClient && grep -hoE 'data-testid=\\{?[`\"][^`\"]+[`\"]' src/pages/Gantt/components/GanttFeatureRow/GanttFeatureRow.tsx src/pages/Gantt/components/GanttFeatureTrackBand/GanttFeatureTrackBand.tsx src/pages/Gantt/components/GanttTrackStageRow/GanttTrackStageRow.tsx | sort -u",
      "tolerance": { "kind": "exact" }
    },
    {
      "id": "frozen_testid_props_rows",
      "kind": "text",
      "command": "cd OneMoreTaskTracker.WebClient && grep -hoE 'testId=\\{?[`\"][^`\"}]+[`\"]?' src/pages/Gantt/components/GanttFeatureRow/GanttFeatureRow.tsx src/pages/Gantt/components/GanttFeatureTrackBand/GanttFeatureTrackBand.tsx src/pages/Gantt/components/GanttTrackStageRow/GanttTrackStageRow.tsx | sort -u",
      "tolerance": { "kind": "exact" }
    },
    {
      "id": "frozen_aria_attrs_rows",
      "kind": "text",
      "command": "cd OneMoreTaskTracker.WebClient && grep -hoE '(role|aria-modal|aria-haspopup|aria-expanded|aria-selected|aria-activedescendant|aria-label|aria-labelledby|aria-controls|aria-invalid)=' src/pages/Gantt/components/GanttFeatureRow/GanttFeatureRow.tsx src/pages/Gantt/components/GanttFeatureTrackBand/GanttFeatureTrackBand.tsx src/pages/Gantt/components/GanttTrackStageRow/GanttTrackStageRow.tsx | sort | uniq -c | sort -rn",
      "tolerance": { "kind": "exact" }
    },
    {
      "id": "frozen_i18n_keys_rows",
      "kind": "text",
      "command": "cd OneMoreTaskTracker.WebClient && grep -hoE \"['\\\"](tracks|inlineEdit|row)\\.[A-Za-z0-9_.]+['\\\"]\" src/pages/Gantt/components/GanttFeatureRow/GanttFeatureRow.tsx src/pages/Gantt/components/GanttFeatureTrackBand/GanttFeatureTrackBand.tsx src/pages/Gantt/components/GanttTrackStageRow/GanttTrackStageRow.tsx | sort -u",
      "tolerance": { "kind": "exact" }
    },
    {
      "id": "sticky_gutter_decl_count",
      "kind": "text",
      "command": "cd OneMoreTaskTracker.WebClient && grep -cE 'position:[[:space:]]*sticky' src/pages/Gantt/components/GanttGutter/Gutter.css src/pages/Gantt/components/GanttFeatureRow/GanttFeatureRow.css src/pages/Gantt/components/GanttFeatureTrackBand/GanttFeatureTrackBand.css src/pages/Gantt/components/GanttTrackStageRow/GanttTrackStageRow.css 2>/dev/null | sort",
      "tolerance": { "kind": "exact" }
    },
    {
      "id": "sticky_gutter_inset_inline_start",
      "kind": "text",
      "command": "cd OneMoreTaskTracker.WebClient && grep -nE 'inset-inline-start:[[:space:]]*0' src/pages/Gantt/components/GanttGutter/Gutter.css src/pages/Gantt/components/GanttFeatureRow/GanttFeatureRow.css src/pages/Gantt/components/GanttFeatureTrackBand/GanttFeatureTrackBand.css src/pages/Gantt/components/GanttTrackStageRow/GanttTrackStageRow.css 2>/dev/null | sort",
      "tolerance": { "kind": "exact" }
    },
    {
      "id": "border_inline_end_gutter",
      "kind": "text",
      "command": "cd OneMoreTaskTracker.WebClient && grep -nE 'border-inline-end:[[:space:]]*1px' src/pages/Gantt/components/GanttGutter/Gutter.css src/pages/Gantt/components/GanttFeatureRow/GanttFeatureRow.css src/pages/Gantt/components/GanttFeatureTrackBand/GanttFeatureTrackBand.css src/pages/Gantt/components/GanttTrackStageRow/GanttTrackStageRow.css 2>/dev/null | sort",
      "tolerance": { "kind": "exact" }
    },
    {
      "id": "host_overflow_rules_gantt",
      "kind": "text",
      "command": "cd OneMoreTaskTracker.WebClient && grep -rnE 'overflow:[[:space:]]*hidden' src/pages/Gantt/ | sort",
      "tolerance": { "kind": "exact" }
    },
    {
      "id": "binding_e2e_specs_hash",
      "kind": "text",
      "command": "cd OneMoreTaskTracker.WebClient && shasum -a 256 e2e/specs/gantt-picker-popover-visible.spec.ts e2e/specs/gantt-left-panel-bugs.spec.ts e2e/specs/plan.happy-path.spec.ts e2e/specs/task-lifecycle.spec.ts | awk '{print $1\"  \"$2}'",
      "tolerance": { "kind": "exact" }
    },
    {
      "id": "gantt_gutter_width_value",
      "kind": "text",
      "command": "cd OneMoreTaskTracker.WebClient && grep -nE -- '--gantt-gutter-width:' src/pages/Gantt/GanttPage.css",
      "tolerance": { "kind": "exact" }
    },
    {
      "id": "feature_row_min_height_invariant",
      "kind": "text",
      "command": "cd OneMoreTaskTracker.WebClient && grep -nE 'min-(height|block-size):' src/pages/Gantt/components/GanttFeatureRow/GanttFeatureRow.css src/pages/Gantt/components/GanttFeatureTrackBand/GanttFeatureTrackBand.css src/pages/Gantt/components/GanttTrackStageRow/GanttTrackStageRow.css | sort",
      "tolerance": { "kind": "exact" }
    },
    {
      "id": "row_test_files_hash",
      "kind": "text",
      "command": "cd OneMoreTaskTracker.WebClient && shasum -a 256 tests/pages/Gantt/components/GanttFeatureRow/GanttFeatureRow.test.tsx tests/pages/Gantt/components/GanttFeatureTrackBand/GanttFeatureTrackBand.test.tsx tests/pages/Gantt/components/GanttTrackStageRow/GanttTrackStageRow.test.tsx | awk '{print $1\"  \"$2}'",
      "tolerance": { "kind": "exact" }
    }
  ]
}
